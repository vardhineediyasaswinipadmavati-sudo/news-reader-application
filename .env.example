# NEWSLY - Genuine News API Configuration Example
# Copy this file to .env and insert your API key.
#
# Production Deployment on Vercel:
# Set GNEWS_API_KEY in your Vercel Project Settings > Environment Variables.
# This keeps your API key secure on the server and powers live news for visitors.
# GNEWS_API_KEY=your_gnews_api_key_here
#
# Supported News Providers (Client-Side & Development):
# 1. GNews (Recommended for global & topic coverage):
#    Get your free API key at: https://gnews.io/ (100 free requests/day)
#    VITE_NEWS_API_PROVIDER=gnews
#    VITE_NEWS_API_KEY=your_gnews_api_key_here
#
# 2. The Guardian Open Platform (Alternative high-quality journalism):
#    Get your free developer key at: https://open-platform.theguardian.com/access/
#    Users must obtain and enter their own valid Guardian developer API key.
#    VITE_NEWS_API_PROVIDER=guardian
#    VITE_NEWS_API_KEY=your_guardian_api_key_here
#
# 3. NewsData.io (Alternative global news API):
#    Get your free API key at: https://newsdata.io/
#    VITE_NEWS_API_PROVIDER=newsdata
#    VITE_NEWS_API_KEY=your_newsdata_api_key_here

VITE_NEWS_API_PROVIDER=gnews
VITE_NEWS_API_KEY=
